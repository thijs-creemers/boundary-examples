{:tasks
 {test-all
  {:doc "Run tests for all examples"
   :task (do
           (babashka.process/shell {:dir "blog-app"} "clojure" "-M:test")
           (babashka.process/shell {:dir "notification-service"} "clojure" "-M:test")
           (babashka.process/shell {:dir "ecommerce-api"} "clojure" "-M:test"))}

  bump-boundary
  {:doc "Bump Boundary library version across all examples. Usage: bb bump-boundary 1.0.0-beta-2"
   :task (let [new-ver (first *command-line-args*)]
           (when-not new-ver (throw (ex-info "Usage: bb bump-boundary <version>" {})))
           (doseq [f ["ecommerce-api/deps.edn" "blog-app/deps.edn"]]
             (spit f (clojure.string/replace (slurp f) (re-pattern "1\\.\\d+\\.\\d+-(alpha|beta)-\\d+") new-ver)))
           (println "Bumped to" new-ver))}

  run-ecommerce
  {:doc "Run ecommerce-api with a dev JWT_SECRET"
   :task (babashka.process/shell
          {:dir "ecommerce-api"
           :extra-env {"JWT_SECRET" "dev-secret-change-me-min-32-characters"}}
          "clojure" "-M:run")}}}
