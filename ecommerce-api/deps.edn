{:paths ["src" "resources"]

 :deps  {;; Boundary framework (from Clojars)
         ;; boundary-admin transitively provides: boundary-user, boundary-core,
         ;; boundary-ui-style, buddy-hashers, buddy-sign, hiccup
         org.boundary-app/boundary-admin         {:mvn/version "1.0.0-beta-1"}
         ;; boundary-platform provides: next.jdbc, honeysql, HikariCP, reitit,
         ;; muuntaja, integrant, aero, cheshire
         org.boundary-app/boundary-platform      {:mvn/version "1.0.0-beta-1"}
         ;; boundary-observability provides: tools.logging, logback
         org.boundary-app/boundary-observability {:mvn/version "1.0.0-beta-1"}
         org.boundary-app/boundary-core          {:mvn/version "1.0.0-beta-1"}
         org.boundary-app/boundary-user          {:mvn/version "1.0.0-beta-1"}
         org.boundary-app/boundary-cache         {:mvn/version "1.0.0-beta-1"}
         org.boundary-app/boundary-ui-style      {:mvn/version "1.0.0-beta-1"}

         ;; Web server
         ring/ring-core                          {:mvn/version "1.15.4"}
         ring/ring-jetty-adapter                 {:mvn/version "1.15.4"}

         ;; Routing
         metosin/reitit                          {:mvn/version "0.10.1"}
         metosin/reitit-swagger                  {:mvn/version "0.10.1"}
         metosin/reitit-swagger-ui               {:mvn/version "0.10.1"}

         ;; Database
         com.github.seancorfield/next.jdbc       {:mvn/version "1.3.1093"}
         org.xerial/sqlite-jdbc                  {:mvn/version "3.53.0.0"}

         ;; Configuration
         aero/aero                               {:mvn/version "1.1.6"}

         ;; System lifecycle
         integrant/integrant                     {:mvn/version "1.0.1"}

         ;; Validation
         metosin/malli                           {:mvn/version "0.20.1"}

         ;; JSON
         metosin/muuntaja                        {:mvn/version "0.6.11"}
         cheshire/cheshire                       {:mvn/version "6.2.0"}

         ;; Crypto (for webhook signatures)
         buddy/buddy-core                        {:mvn/version "1.12.0-430"}

         ;; Logging
         ch.qos.logback/logback-classic          {:mvn/version "1.5.32"}}

 :aliases
 {:dev
  {:extra-paths ["test"]
   :extra-deps  {integrant/repl {:mvn/version "0.5.1"}}}

  :repl-clj
  {:extra-paths ["dev"]
   :extra-deps  {integrant/repl    {:mvn/version "0.5.1"}
                 nrepl/nrepl       {:mvn/version "1.7.0"}
                 cider/cider-nrepl {:mvn/version "0.59.0"}}
   :main-opts   ["-m" "nrepl.cmdline"
                 "--middleware" "[cider.nrepl/cider-middleware]"
                 "--port" "7890"]}

  :test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :run
  {:main-opts ["-m" "ecommerce.main"]}

  ;; Used by `bb create-admin --dir ecommerce-api` (from boundary-examples root)
  :cli
  {:main-opts ["-m" "boundary.cli"]
   :jvm-opts  ["-Denv=dev"]}

  :db
  {:extra-deps {org.xerial/sqlite-jdbc {:mvn/version "3.53.0.0"}}}

  :smoke
  {:extra-paths ["dev"]
   :main-opts   ["-m" "smoke"]}}}
